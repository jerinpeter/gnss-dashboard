[Unit]
Description=RTCM3 WiFi bridge from base station to rover GPS correction input
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openmind
ExecStart=/usr/bin/python3 -u /home/openmind/rtcm_bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
